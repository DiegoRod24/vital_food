{
  "name": "vital-food-control",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf:dev": "npm run build && wrangler pages dev dist --d1 DB=vital-foods-db",
    "cf:migrate:local": "wrangler d1 migrations apply vital-foods-db --local",
    "cf:migrate:remote": "wrangler d1 migrations apply vital-foods-db --remote",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.7",
    "wrangler": "^4.35.0"
  }
}
